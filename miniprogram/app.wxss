/* 德高农牧 · 设计系统 */
page {
  --c-primary: #0D3B2E;
  --c-primary-2: #17533F;
  --c-primary-3: #2C7A5B;
  --c-gold: #B8915A;
  --c-gold-soft: #F3EADB;
  --c-bg: #F5F3EE;
  --c-card: #FFFFFF;
  --c-text: #17201C;
  --c-sub: #66706B;
  --c-muted: #9AA19D;
  --c-line: #E8E4DB;
  --c-mint: #E7F0EB;
  --radius: 24rpx;
  --radius-sm: 14rpx;
  --shadow: 0 8rpx 32rpx rgba(13, 59, 46, 0.06);

  background: var(--c-bg);
  color: var(--c-text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, input, textarea, button { box-sizing: border-box; }

.container { padding: 0 32rpx; }

/* 区块标题 */
.section { margin-top: 56rpx; }
.section-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  padding: 0 32rpx; margin-bottom: 24rpx;
}
.section-title { font-size: 38rpx; font-weight: 700; letter-spacing: 0.5rpx; color: var(--c-text); }
.section-sub { font-size: 24rpx; color: var(--c-sub); margin-top: 6rpx; }
.section-link { font-size: 24rpx; color: var(--c-primary-3); white-space: nowrap; }
.eyebrow {
  font-size: 20rpx; letter-spacing: 4rpx; text-transform: uppercase;
  color: var(--c-gold); font-weight: 600;
}

/* 卡片 */
.card {
  background: var(--c-card); border-radius: var(--radius);
  box-shadow: var(--shadow); padding: 32rpx;
}

/* 按钮 */
.btn {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; border-radius: 44rpx; padding: 0 40rpx;
  font-size: 28rpx; font-weight: 600; line-height: 1;
}
.btn-primary { background: var(--c-primary); color: #fff; }
.btn-gold { background: var(--c-gold); color: #fff; }
.btn-ghost { background: transparent; color: var(--c-primary); border: 2rpx solid var(--c-primary); }
.btn-light { background: rgba(255,255,255,0.14); color: #fff; border: 2rpx solid rgba(255,255,255,0.35); }
.btn-hover { opacity: 0.85; }

/* 标签 */
.tag {
  display: inline-flex; align-items: center; height: 44rpx; padding: 0 18rpx;
  border-radius: 22rpx; font-size: 22rpx; background: var(--c-mint); color: var(--c-primary-2);
  margin-right: 12rpx; margin-bottom: 12rpx;
}
.tag-gold { background: var(--c-gold-soft); color: #8A6A3A; }

.price { color: var(--c-primary); font-weight: 700; }
.price-unit { font-size: 22rpx; color: var(--c-sub); font-weight: 400; }

.demo-note {
  text-align: center; font-size: 20rpx; color: var(--c-muted); padding: 32rpx 32rpx 48rpx;
}

.divider { height: 1rpx; background: var(--c-line); margin: 28rpx 0; }

/* 底部操作栏 */
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
  background: rgba(255,255,255,0.96); border-top: 1rpx solid var(--c-line);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center;
}
.bottom-spacer { height: calc(150rpx + env(safe-area-inset-bottom)); }

/* 表单 */
.field { padding: 24rpx 0; border-bottom: 1rpx solid var(--c-line); }
.field:last-child { border-bottom: none; }
.field-label { font-size: 24rpx; color: var(--c-sub); margin-bottom: 10rpx; }
.field-input { font-size: 30rpx; color: var(--c-text); height: 56rpx; width: 100%; }
.field-textarea { font-size: 28rpx; width: 100%; height: 160rpx; line-height: 1.5; }
.placeholder { color: #B4BAB6; }

/* 列表行 */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.chev { width: 14rpx; height: 14rpx; border-top: 3rpx solid var(--c-muted); border-right: 3rpx solid var(--c-muted); transform: rotate(45deg); margin-left: 12rpx; }
