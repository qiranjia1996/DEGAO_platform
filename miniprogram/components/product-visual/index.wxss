.bag {
  position: relative; overflow: hidden; background: #fff; color: #1F2421;
  display: flex; flex-direction: column;
}
.bag-md { height: 320rpx; }
.bag-sm { height: 220rpx; }
.bag-lg { height: 640rpx; }

.bag-band-top { height: 10rpx; background: #0A5A3A; flex-shrink: 0; }
.bag-lg .bag-band-top { height: 18rpx; }

/* 包装右上角的点阵 */
.bag-dots {
  position: absolute; right: 14rpx; top: 26rpx; width: 96rpx; height: 96rpx;
  background-image: radial-gradient(#C9CFCB 1.6rpx, transparent 1.8rpx);
  background-size: 14rpx 14rpx;
}
.bag-lg .bag-dots { width: 200rpx; height: 220rpx; right: 32rpx; top: 56rpx; background-size: 22rpx 22rpx;
  background-image: radial-gradient(#C9CFCB 2.4rpx, transparent 2.8rpx); }
.bag-sm .bag-dots { width: 64rpx; height: 64rpx; right: 10rpx; top: 20rpx; background-size: 12rpx 12rpx; }

.bag-head { display: flex; align-items: center; padding: 18rpx 20rpx 0; position: relative; }
.bag-logo { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.bag-brand { display: flex; flex-direction: column; margin-left: 8rpx; font-size: 12rpx; line-height: 1.15; letter-spacing: 1.5rpx; color: #0A5A3A; font-weight: 600; }
.bag-lg .bag-head { padding: 44rpx 48rpx 0; }
.bag-lg .bag-logo { width: 64rpx; height: 64rpx; }
.bag-lg .bag-brand { font-size: 20rpx; margin-left: 14rpx; letter-spacing: 3rpx; }
.bag-sm .bag-head { padding: 14rpx 16rpx 0; }
.bag-sm .bag-logo { width: 28rpx; height: 28rpx; }
.bag-sm .bag-brand { display: none; }

.bag-body { flex: 1; padding: 0 20rpx; display: flex; flex-direction: column; justify-content: center; position: relative; min-height: 0; }
.bag-lg .bag-body { padding: 0 48rpx; }
.bag-sm .bag-body { padding: 0 16rpx; }

.bag-name {
  font-family: "Songti SC", "Noto Serif SC", "Noto Serif CJK SC", STSong, serif; font-weight: 700;
  font-size: 24rpx; line-height: 1.3; color: #1F2421; letter-spacing: 1rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.bag-lg .bag-name { font-family: "DG Brush", "Songti SC", "Noto Serif SC", STSong, serif; font-weight: normal; font-size: 64rpx; letter-spacing: 6rpx; white-space: normal; }
.bag-sm .bag-name { font-size: 20rpx; }

.bag-big {
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; color: #0A5A3A;
  font-size: 64rpx; font-weight: 300; line-height: 1.1; letter-spacing: -1rpx; margin-top: 4rpx;
}
.bag-big-mark { font-size: 48rpx; font-weight: 400; letter-spacing: 3rpx; }
.bag-lg .bag-big { font-size: 140rpx; margin-top: 12rpx; }
.bag-lg .bag-big-mark { font-size: 104rpx; }
.bag-sm .bag-big { font-size: 46rpx; }
.bag-sm .bag-big-mark { font-size: 34rpx; }

.bag-formula { font-size: 18rpx; color: #6B716D; margin-top: 2rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; letter-spacing: 1rpx; }
.bag-lg .bag-formula { font-size: 26rpx; margin-top: 8rpx; }
.bag-sm .bag-formula { display: none; }

.bag-species { display: flex; margin-top: 32rpx; }
.bag-sp { display: flex; flex-direction: column; align-items: center; font-size: 20rpx; color: #0A5A3A; padding: 0 22rpx; border-left: 1rpx solid #D5DED8; }
.bag-sp:first-child { border-left: none; padding-left: 0; }
.bag-sp-icon { width: 52rpx; height: 52rpx; margin-bottom: 4rpx; }

.bag-band-bottom {
  height: 52rpx; background: #0A5A3A; color: #fff; flex-shrink: 0;
  display: flex; align-items: center; padding: 0 20rpx; font-size: 18rpx; letter-spacing: 2rpx;
}
.bag-redbar { width: 4rpx; height: 24rpx; background: #C8323A; margin-right: 12rpx; flex-shrink: 0; }
.bag-form { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bag-code { opacity: 0.6; letter-spacing: 1rpx; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
.bag-lg .bag-band-bottom { height: 96rpx; padding: 0 48rpx; font-size: 24rpx; }
.bag-lg .bag-redbar { width: 6rpx; height: 44rpx; margin-right: 20rpx; }
.bag-sm .bag-band-bottom { height: 40rpx; padding: 0 16rpx; font-size: 16rpx; }
.bag-sm .bag-redbar { height: 18rpx; margin-right: 8rpx; }
.bag-sm .bag-code { display: none; }
