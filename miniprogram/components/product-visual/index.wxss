.pv { position: relative; overflow: hidden; color: #fff; display: flex; flex-direction: column; justify-content: space-between; }
.pv-md { height: 300rpx; padding: 22rpx 24rpx; }
.pv-sm { height: 220rpx; padding: 18rpx 18rpx; }
.pv-lg { height: 560rpx; padding: 48rpx 48rpx 44rpx; }

.cat-acid   { background: linear-gradient(140deg, #0D3B2E 0%, #1E6A4F 100%); }
.cat-nutri  { background: linear-gradient(140deg, #13304D 0%, #2B5C86 100%); }
.cat-plant  { background: linear-gradient(140deg, #34431A 0%, #667A2B 100%); }
.cat-bio    { background: linear-gradient(140deg, #3E2643 0%, #74507A 100%); }
.cat-detox  { background: linear-gradient(140deg, #4B3018 0%, #8A6436 100%); }

.ring { position: absolute; border-radius: 50%; border: 2rpx solid rgba(255,255,255,0.14); }
.ring-a { width: 260rpx; height: 260rpx; right: -80rpx; top: -70rpx; }
.ring-b { width: 180rpx; height: 180rpx; right: -40rpx; top: -30rpx; border-color: rgba(212,177,122,0.35); }
.pv-lg .ring-a { width: 620rpx; height: 620rpx; right: -200rpx; top: -180rpx; }
.pv-lg .ring-b { width: 420rpx; height: 420rpx; right: -100rpx; top: -80rpx; }

.pv-head { display: flex; justify-content: space-between; align-items: center; position: relative; }
.pv-brand { font-size: 18rpx; letter-spacing: 4rpx; opacity: 0.7; }
.pv-mark { font-size: 18rpx; letter-spacing: 2rpx; color: #E3C795; border: 1rpx solid rgba(227,199,149,0.6); padding: 2rpx 10rpx; border-radius: 6rpx; }
.pv-main { position: relative; }
.pv-big { font-size: 72rpx; font-weight: 300; letter-spacing: -2rpx; line-height: 1; }
.pv-big-mark { font-size: 56rpx; font-weight: 500; letter-spacing: 4rpx; }
.pv-sm .pv-big { font-size: 52rpx; }
.pv-sm .pv-big-mark { font-size: 40rpx; }
.pv-lg .pv-big { font-size: 150rpx; }
.pv-lg .pv-big-mark { font-size: 110rpx; }
.pv-lg .pv-brand, .pv-lg .pv-mark { font-size: 24rpx; }

.pv-foot { display: flex; flex-direction: column; position: relative; }
.pv-formula { font-size: 22rpx; opacity: 0.85; font-family: Georgia, "Times New Roman", serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pv-form { font-size: 18rpx; opacity: 0.6; margin-top: 2rpx; }
.pv-sm .pv-form { display: none; }
.pv-lg .pv-formula { font-size: 32rpx; }
.pv-lg .pv-form { font-size: 24rpx; margin-top: 8rpx; }
