.pc { background: #fff; border: 1rpx solid #E3E1DB; border-radius: 8rpx; overflow: hidden; }
.pc-hover { background: #FAFAF8; }
.pc-body { padding: 18rpx 20rpx 20rpx; border-top: 1rpx solid #EFEDE8; }
.pc-cat { font-size: 20rpx; color: #9EA39F; letter-spacing: 2rpx; }
.pc-title {
  font-size: 27rpx; font-weight: 500; color: #1F2421; line-height: 1.4; margin-top: 4rpx; min-height: 76rpx;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.pc-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; }
.price { color: #0A5A3A; font-weight: 600; font-size: 30rpx; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
.price-unit { font-size: 20rpx; color: #9EA39F; font-weight: 400; }
.pc-add {
  width: 48rpx; height: 48rpx; border-radius: 4rpx; border: 1rpx solid #0A5A3A; color: #0A5A3A;
  display: flex; align-items: center; justify-content: center; font-size: 30rpx; line-height: 1; font-weight: 300;
}
.btn-hover { background: #0A5A3A; color: #fff; }

.pcl { display: flex; background: #fff; border: 1rpx solid #E3E1DB; border-radius: 8rpx; overflow: hidden; }
.pcl-visual { width: 200rpx; flex-shrink: 0; border-right: 1rpx solid #EFEDE8; }
.pcl-body { flex: 1; padding: 18rpx 24rpx; min-width: 0; }
.pcl .pc-title { min-height: 0; }
.pcl-benefit { font-size: 22rpx; color: #6B716D; margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
