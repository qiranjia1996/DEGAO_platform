.success { background: #fff; border-bottom: 1rpx solid var(--c-line); padding: 64rpx 40rpx 56rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.success-icon { width: 112rpx; height: 112rpx; border-radius: 50%; border: 2rpx solid var(--c-green); display: flex; align-items: center; justify-content: center; position: relative; }
.success-icon::before { content: ''; position: absolute; left: 10rpx; top: 10rpx; right: 10rpx; bottom: 10rpx; border-radius: 50%; border: 1rpx solid #C6D6CC; }
.tick { width: 20rpx; height: 38rpx; border-right: 4rpx solid var(--c-green); border-bottom: 4rpx solid var(--c-green); transform: rotate(45deg); margin-top: -10rpx; }
.success-t { font-family: var(--brush); font-weight: normal; font-size: 46rpx; margin-top: 32rpx; letter-spacing: 4rpx; }
.success-s { font-size: 25rpx; color: var(--c-sub); margin-top: 12rpx; line-height: 1.6; }
.success-btn { margin-top: 40rpx; width: 280rpx; height: 76rpx; }

.empty { text-align: center; color: var(--c-muted); padding: 160rpx 0; }
.order { background: #fff; margin: 20rpx 32rpx 0; border: 1rpx solid var(--c-line); border-radius: 8rpx; padding: 28rpx; }
.order-new { border-color: var(--c-green); }
.order-head { display: flex; justify-content: space-between; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--c-line-2); }
.order-no { font-size: 23rpx; color: var(--c-sub); font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; letter-spacing: 1rpx; }
.order-status { font-size: 23rpx; color: var(--c-red); }
.order-item { display: flex; justify-content: space-between; padding: 14rpx 0 0; font-size: 26rpx; }
.oi-qty { color: var(--c-sub); }
.order-foot { display: flex; justify-content: space-between; align-items: baseline; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid var(--c-line-2); }
.of-time { font-size: 22rpx; color: var(--c-muted); }
