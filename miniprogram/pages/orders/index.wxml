<view wx:if="{{newNo}}" class="success">
  <view class="success-icon"><view class="tick"></view></view>
  <view class="success-t">{{t.checkout.success}}</view>
  <view class="success-s">{{t.checkout.successSub}}</view>
  <view class="btn btn-light success-btn" bindtap="home" hover-class="btn-hover">{{t.tabs[0]}}</view>
</view>

<view wx:if="{{!orders.length}}" class="empty">{{t.orders.empty}}</view>

<view class="order {{item.no === newNo ? 'order-new' : ''}}" wx:for="{{orders}}" wx:key="no">
  <view class="order-head">
    <text class="order-no">{{t.orders.no}} {{item.no}}</text>
    <text class="order-status">{{t.orders.status}}</text>
  </view>
  <view class="order-item" wx:for="{{item.items}}" wx:for-item="it" wx:key="id">
    <text class="oi-title">{{it.title}}</text>
    <text class="oi-qty">× {{it.qty}}</text>
  </view>
  <view class="order-foot">
    <text class="of-time">{{item.time}} · {{item.info.company}}</text>
    <text class="price">¥{{item.total}}</text>
  </view>
</view>

<view class="demo-note">{{t.common.demo}}</view>
