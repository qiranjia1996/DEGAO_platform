.top { background: #fff; padding: 20rpx 0 0; position: sticky; top: 0; z-index: 5; border-bottom: 1rpx solid var(--c-line); }
.search { margin: 0 32rpx; height: 72rpx; border-radius: 6rpx; background: var(--c-paper); border: 1rpx solid var(--c-line); display: flex; align-items: center; padding: 0 24rpx; }
.search-icon { width: 24rpx; height: 24rpx; border: 2rpx solid var(--c-muted); border-radius: 50%; position: relative; flex-shrink: 0; }
.search-icon::after { content: ''; position: absolute; width: 9rpx; height: 2rpx; background: var(--c-muted); right: -8rpx; bottom: -3rpx; transform: rotate(45deg); }
.search-input { flex: 1; margin-left: 18rpx; font-size: 26rpx; }
.search-clear { font-size: 34rpx; color: var(--c-muted); padding: 0 0 0 16rpx; }

/* 类别：文字标签，选中时下方一条绿色细线 */
.chips { white-space: nowrap; margin-top: 12rpx; }
.chips-inner { display: inline-flex; padding: 0 16rpx; }
.chip { display: inline-flex; align-items: center; height: 76rpx; padding: 0 18rpx; font-size: 26rpx; color: var(--c-sub); position: relative; }
.chip-on { color: var(--c-ink); font-weight: 600; }
.chip-on::after { content: ''; position: absolute; left: 18rpx; right: 18rpx; bottom: 0; height: 4rpx; background: var(--c-green); }

.species { display: flex; align-items: center; padding: 18rpx 32rpx; border-top: 1rpx solid var(--c-line-2); }
.species-label { font-size: 22rpx; color: var(--c-muted); margin-right: 18rpx; letter-spacing: 1rpx; }
.sp { font-size: 23rpx; color: var(--c-sub); padding: 4rpx 18rpx; border-radius: 4rpx; margin-right: 10rpx; border: 1rpx solid transparent; }
.sp-on { color: var(--c-green); border-color: var(--c-green); }

.count { font-size: 22rpx; color: var(--c-muted); padding: 28rpx 32rpx 16rpx; letter-spacing: 1rpx; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 0 32rpx; }
.cell { width: calc(50% - 9rpx); margin-bottom: 18rpx; }
.empty { text-align: center; color: var(--c-muted); padding: 120rpx 0; }
