.visual { border-bottom: 1rpx solid var(--c-line); background: #fff; }

.head { background: #fff; padding: 36rpx 32rpx 28rpx; border-bottom: 1rpx solid var(--c-line); }
.head-cat { font-size: 22rpx; color: var(--c-muted); letter-spacing: 2rpx; }
.head-title { font-family: var(--serif); font-size: 42rpx; font-weight: 700; margin-top: 10rpx; line-height: 1.35; letter-spacing: 2rpx; }
.head-price { margin-top: 18rpx; display: flex; align-items: baseline; }
.price.big { font-size: 50rpx; font-weight: 500; }
.bag { font-size: 22rpx; color: var(--c-muted); margin-left: 20rpx; }
.tags { margin-top: 22rpx; }

.block { background: #fff; margin-top: 20rpx; padding: 36rpx 32rpx; border-top: 1rpx solid var(--c-line); border-bottom: 1rpx solid var(--c-line); }
.block-title { font-family: var(--brush); font-weight: normal; font-size: 36rpx; margin-bottom: 24rpx; letter-spacing: 2rpx; border-left: 6rpx solid var(--c-red); padding-left: 18rpx; line-height: 1.2; }

.grades { display: flex; flex-wrap: wrap; margin-right: -14rpx; }
.grade { border: 1rpx solid var(--c-line); border-radius: 6rpx; padding: 14rpx 22rpx; margin: 0 14rpx 14rpx 0; display: flex; flex-direction: column; }
.grade-on { border-color: var(--c-green); background: var(--c-green-soft); }
.grade-name { font-size: 25rpx; font-weight: 500; }
.grade-on .grade-name { color: var(--c-green); }
.grade-price { font-size: 21rpx; color: var(--c-sub); }

.intro { font-size: 27rpx; color: #3A403C; line-height: 1.9; }
.ask-ai { margin-top: 26rpx; border: 1rpx solid #C6D6CC; border-radius: 6rpx; padding: 22rpx 24rpx; display: flex; align-items: center; font-size: 25rpx; color: var(--c-green); }
.ask-ai text:nth-child(2) { flex: 1; }
.ask-star { color: var(--c-green); margin-right: 12rpx; }

.benefits { border-top: 1rpx solid var(--c-line-2); }
.benefit { display: flex; align-items: baseline; padding: 22rpx 0; border-bottom: 1rpx solid var(--c-line-2); }
.benefit-no { font-size: 24rpx; color: var(--c-red); width: 64rpx; flex-shrink: 0; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; letter-spacing: 1rpx; }
.benefit-text { font-size: 27rpx; color: var(--c-ink); line-height: 1.5; }

.spec-table { border-top: 1rpx solid var(--c-line); }
.spec-row { display: flex; padding: 22rpx 0; border-bottom: 1rpx solid var(--c-line-2); font-size: 25rpx; }
.spec-k { width: 200rpx; color: var(--c-sub); flex-shrink: 0; }
.spec-v { flex: 1; color: var(--c-ink); }
.note { font-size: 22rpx; color: var(--c-muted); margin-top: 20rpx; line-height: 1.6; }

.rel { margin-bottom: 16rpx; }

.bb-call { width: 80rpx; height: 80rpx; border-radius: 6rpx; border: 1rpx solid var(--c-line); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.bb-call-t { font-size: 21rpx; color: var(--c-green); }
.stepper { margin: 0 14rpx; flex-shrink: 0; }
.st-btn { width: 56rpx; }
.st-n { min-width: 56rpx; }
.bb-btn { flex: 1; height: 80rpx; font-size: 25rpx; padding: 0 10rpx; margin-left: 12rpx; }

.ref { display: flex; padding: 20rpx 0; border-bottom: 1rpx solid var(--c-line-2); }
.ref:first-of-type { border-top: 1rpx solid var(--c-line-2); }
.ref-no { font-size: 22rpx; color: var(--c-red); width: 56rpx; flex-shrink: 0; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; padding-top: 2rpx; }
.ref-main { flex: 1; min-width: 0; }
.ref-finding { font-size: 25rpx; line-height: 1.65; color: var(--c-ink); }
.ref-meta { font-size: 21rpx; color: var(--c-muted); margin-top: 6rpx; text-decoration: underline; text-decoration-color: #D5D9D6; }

.pending { background: #FFF6E5; color: #8A5A00; font-size: 24rpx; line-height: 1.6; padding: 20rpx 32rpx; border-bottom: 1rpx solid #F0DDB5; }
.para { font-size: 27rpx; color: #3A403C; line-height: 1.9; margin-bottom: 18rpx; }
.para:last-child { margin-bottom: 0; }

.sp-tabs { display: flex; flex-wrap: wrap; margin: 0 -12rpx 12rpx 0; }
.sp-tab { display: flex; align-items: center; border: 1rpx solid var(--c-line); border-radius: 40rpx; padding: 10rpx 24rpx 10rpx 14rpx; margin: 0 12rpx 12rpx 0; font-size: 25rpx; color: var(--c-sub); }
.sp-tab-icon { width: 36rpx; height: 36rpx; margin-right: 8rpx; }
.sp-tab-on { border-color: var(--c-green); background: var(--c-green-soft); color: var(--c-green); font-weight: 500; }
.use { padding: 22rpx 0; border-bottom: 1rpx solid var(--c-line-2); }
.use:first-child { border-top: 1rpx solid var(--c-line-2); }
.use-scene { font-size: 27rpx; font-weight: 600; color: var(--c-ink); margin-bottom: 8rpx; }
.use-text { font-size: 25rpx; color: #3A403C; line-height: 1.75; }
.use-cite { color: var(--c-red); font-size: 21rpx; margin-left: 4rpx; }

.gg { padding: 22rpx 0; border-bottom: 1rpx solid var(--c-line-2); }
.intro + .gg { margin-top: 18rpx; border-top: 1rpx solid var(--c-line-2); }
.gg-head { display: flex; align-items: center; }
.gg-name { font-size: 26rpx; font-weight: 600; color: var(--c-ink); }
.gg-on { color: var(--c-green); }
.gg-cur { font-size: 20rpx; color: var(--c-green); border: 1rpx solid var(--c-green); border-radius: 4rpx; padding: 0 8rpx; margin-left: 12rpx; }
.gg-fit { font-size: 24rpx; color: var(--c-sub); line-height: 1.7; margin-top: 6rpx; }

.faq { border-bottom: 1rpx solid var(--c-line-2); padding: 22rpx 0; }
.faq:first-of-type { border-top: 1rpx solid var(--c-line-2); }
.faq-q { display: flex; align-items: center; }
.faq-mark { font-size: 22rpx; color: var(--c-red); width: 40rpx; flex-shrink: 0; font-weight: 600; }
.faq-qt { flex: 1; font-size: 26rpx; color: var(--c-ink); font-weight: 500; line-height: 1.5; }
.chev-down { transform: rotate(135deg); }
.chev-up { transform: rotate(-45deg); margin-top: 8rpx; }
.faq-a { font-size: 25rpx; color: #3A403C; line-height: 1.8; margin: 14rpx 0 0 40rpx; }
