.intro { position: relative; overflow: hidden; background: #fff; padding: 40rpx 32rpx 44rpx; border-bottom: 1rpx solid var(--c-line); }
.intro-mol { position: absolute; right: -170rpx; bottom: -60rpx; width: 420rpx; height: 300rpx; opacity: 0.4;
  background: url("data:image/svg+xml;base64,") no-repeat center / contain; }
.mode { font-size: 20rpx; color: var(--c-green); border: 1rpx solid #C6D6CC; padding: 2rpx 14rpx; border-radius: 4rpx; position: relative; }
.intro-title { font-family: var(--brush); font-weight: normal; font-size: 54rpx; margin-top: 28rpx; letter-spacing: 4rpx; line-height: 1.3; position: relative; }
.intro-sub { font-size: 25rpx; color: var(--c-sub); margin-top: 18rpx; line-height: 1.8; position: relative; max-width: 600rpx; }

.examples { margin: 40rpx 32rpx 0; }
.ex-label { font-size: 22rpx; color: var(--c-muted); margin-bottom: 14rpx; letter-spacing: 2rpx; }
.ex-list { background: #fff; border: 1rpx solid var(--c-line); border-radius: 8rpx; overflow: hidden; }
.ex { padding: 28rpx 24rpx; display: flex; align-items: center; border-bottom: 1rpx solid var(--c-line-2); }
.ex:last-child { border-bottom: none; }
.ex-q { font-size: 22rpx; color: var(--c-red); width: 60rpx; flex-shrink: 0; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; letter-spacing: 1rpx; }
.ex-text { flex: 1; font-size: 27rpx; color: var(--c-ink); }

.chat { padding: 8rpx 32rpx 0; }
.msg-user { display: flex; justify-content: flex-end; margin-top: 32rpx; }
.msg-user text { max-width: 82%; background: var(--c-green); color: #fff; border-radius: 6rpx; padding: 20rpx 26rpx; font-size: 27rpx; line-height: 1.6; }

.msg-ai { background: #fff; border: 1rpx solid var(--c-line); border-radius: 8rpx; padding: 30rpx 28rpx; margin-top: 28rpx; }
.ai-head { display: flex; align-items: center; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--c-line-2); }
.ai-avatar { width: 40rpx; height: 40rpx; }
.ai-name { font-family: var(--brush); font-weight: normal; font-size: 34rpx; margin-left: 14rpx; flex: 1; letter-spacing: 2rpx; }
.ai-mode { font-size: 20rpx; color: var(--c-green); border: 1rpx solid #C6D6CC; padding: 2rpx 12rpx; border-radius: 4rpx; }
.ai-warn { font-size: 22rpx; color: var(--c-red); margin-top: 16rpx; }
.ai-summary { font-size: 27rpx; line-height: 1.8; color: #2F3531; margin-top: 20rpx; }

.rec { border: 1rpx solid var(--c-line); border-radius: 6rpx; margin-top: 24rpx; overflow: hidden; }
.rec-top { display: flex; align-items: stretch; position: relative; border-bottom: 1rpx solid var(--c-line-2); }
.rec-no { position: absolute; right: 20rpx; top: 18rpx; z-index: 2; font-size: 22rpx; color: var(--c-red); font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; letter-spacing: 1rpx; }
.rec-visual { width: 190rpx; flex-shrink: 0; border-right: 1rpx solid var(--c-line-2); }
.rec-main { flex: 1; padding: 18rpx 22rpx; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
.rec-cat { font-size: 20rpx; color: var(--c-muted); letter-spacing: 1rpx; }
.rec-title { font-size: 28rpx; font-weight: 500; margin: 4rpx 0 6rpx; line-height: 1.4; padding-right: 40rpx; }
.rec-line { display: flex; padding: 16rpx 22rpx 0; font-size: 24rpx; line-height: 1.6; }
.rec-k { color: var(--c-muted); width: 130rpx; flex-shrink: 0; }
.rec-v { flex: 1; color: #2F3531; }
.rec-add { margin: 18rpx 22rpx 22rpx; height: 64rpx; border-radius: 4rpx; border: 1rpx solid var(--c-green); color: var(--c-green); font-size: 24rpx; display: flex; align-items: center; justify-content: center; }

.ai-notes { margin-top: 22rpx; border-left: 4rpx solid #C6D6CC; padding: 6rpx 0 6rpx 20rpx; font-size: 24rpx; color: var(--c-sub); line-height: 1.7; }
.ai-foot { margin-top: 26rpx; }
.ai-all { height: 80rpx; font-size: 26rpx; }
.ai-disc { font-size: 20rpx; color: var(--c-muted); margin-top: 18rpx; line-height: 1.5; }

.loading { display: flex; align-items: center; }
.dots { display: flex; margin-right: 16rpx; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--c-green); margin-right: 8rpx; animation: blink 1.2s infinite ease-in-out; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%, 80%, 100% { opacity: 0.2; } 40% { opacity: 1; } }
.loading-t { font-size: 25rpx; color: var(--c-sub); }

.clear { text-align: center; font-size: 23rpx; color: var(--c-muted); padding: 32rpx 0 0; }

.composer { padding-top: 16rpx; }
.composer-input { flex: 1; height: 80rpx; background: var(--c-paper); border: 1rpx solid var(--c-line); border-radius: 6rpx; padding: 0 26rpx; font-size: 26rpx; }
.composer-send { margin-left: 16rpx; height: 80rpx; padding: 0 32rpx; border-radius: 6rpx; background: #C9CFCB; color: #fff; display: flex; align-items: center; font-size: 26rpx; }
.composer-send.on { background: var(--c-green); }
