.hero {
  position: relative; overflow: hidden; color: #fff;
  background: linear-gradient(160deg, #0A2F24 0%, #0D3B2E 45%, #1B5E46 100%);
  padding-bottom: 120rpx;
}
.hero-ring { position: absolute; border-radius: 50%; border: 2rpx solid rgba(255,255,255,0.08); }
.r1 { width: 720rpx; height: 720rpx; right: -300rpx; top: -200rpx; }
.r2 { width: 520rpx; height: 520rpx; right: -200rpx; top: -100rpx; border-color: rgba(212,177,122,0.25); }
.r3 { width: 300rpx; height: 300rpx; left: -120rpx; bottom: -60rpx; }

.nav { display: flex; align-items: center; padding: 0 32rpx; position: relative; }
.logo { display: flex; align-items: center; }
.logo-mark {
  width: 56rpx; height: 56rpx; border-radius: 14rpx; border: 2rpx solid #D4B17A; color: #D4B17A;
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700;
  letter-spacing: 1rpx; font-family: Georgia, serif;
}
.logo-text { display: flex; flex-direction: column; margin-left: 16rpx; line-height: 1.15; }
.logo-cn { font-size: 28rpx; font-weight: 600; letter-spacing: 2rpx; }
.logo-en { font-size: 18rpx; letter-spacing: 6rpx; opacity: 0.6; }

.hero-body { position: relative; padding: 56rpx 40rpx 0; }
.lang-pill {
  display: flex; align-items: center; height: 52rpx; padding: 0 20rpx; border-radius: 26rpx;
  border: 1rpx solid rgba(255,255,255,0.3); font-size: 22rpx; color: rgba(255,255,255,0.55);
}
.lang-pill .on { color: #fff; font-weight: 600; }
.lang-pill .sep { margin: 0 8rpx; opacity: 0.4; }
.hero-title { font-size: 56rpx; font-weight: 700; line-height: 1.3; margin-top: 20rpx; letter-spacing: 1rpx; }
.hero-sub { font-size: 25rpx; opacity: 0.72; margin-top: 20rpx; line-height: 1.6; max-width: 600rpx; }
.hero-actions { display: flex; margin-top: 44rpx; }
.hero-actions .btn { height: 80rpx; font-size: 26rpx; margin-right: 20rpx; }

.ask {
  position: relative; z-index: 2; margin: -60rpx 32rpx 0; height: 104rpx; border-radius: 52rpx;
  background: #fff; box-shadow: 0 16rpx 48rpx rgba(13,59,46,0.14);
  display: flex; align-items: center; padding: 0 16rpx 0 32rpx;
}
.ask-icon { color: #B8915A; font-size: 32rpx; }
.ask-text { flex: 1; font-size: 25rpx; color: #9AA19D; margin-left: 16rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ask-go {
  width: 72rpx; height: 72rpx; border-radius: 36rpx; background: #0D3B2E; color: #D4B17A;
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; flex-shrink: 0;
}

.stats { display: flex; margin: 40rpx 32rpx 0; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; }
.stat + .stat::before { content: ''; position: absolute; left: 0; top: 14rpx; bottom: 14rpx; width: 1rpx; background: #E0DBD0; }
.stat-v { font-size: 40rpx; font-weight: 700; color: #0D3B2E; font-family: Georgia, serif; }
.stat-l { font-size: 20rpx; color: #66706B; margin-top: 2rpx; text-align: center; }

.sol-grid { display: flex; flex-wrap: wrap; padding: 0 22rpx; }
.sol {
  width: calc(50% - 20rpx); margin: 10rpx; border-radius: 24rpx; padding: 28rpx 26rpx; min-height: 300rpx;
  display: flex; flex-direction: column; color: #fff; position: relative; overflow: hidden;
}
.sol::after { content: ''; position: absolute; width: 220rpx; height: 220rpx; border-radius: 50%; right: -70rpx; bottom: -90rpx; border: 2rpx solid rgba(255,255,255,0.15); }
.sol-pig { background: linear-gradient(150deg, #0D3B2E, #24694F); }
.sol-poultry { background: linear-gradient(150deg, #7A5A2E, #B8915A); }
.sol-ruminant { background: linear-gradient(150deg, #13304D, #2B5C86); }
.sol-aqua { background: linear-gradient(150deg, #0E4A55, #2A8090); }
.sol-en { font-size: 18rpx; letter-spacing: 4rpx; opacity: 0.6; }
.sol-name { font-size: 40rpx; font-weight: 700; margin-top: 4rpx; }
.sol-focus { font-size: 21rpx; opacity: 0.85; margin-top: 8rpx; line-height: 1.5; }
.sol-items { margin-top: auto; padding-top: 16rpx; display: flex; flex-wrap: wrap; }
.sol-item { font-size: 19rpx; background: rgba(255,255,255,0.16); border-radius: 8rpx; padding: 2rpx 10rpx; margin: 6rpx 8rpx 0 0; }

.hscroll { width: 100%; white-space: nowrap; }
.hscroll-inner { display: inline-flex; padding: 8rpx 32rpx 24rpx; }
.feat { width: 300rpx; margin-right: 20rpx; display: inline-block; white-space: normal; }

.cats { padding: 8rpx 28rpx; }
.cat-row { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid #EFECE5; }
.cat-row:last-child { border-bottom: none; }
.row-hover { opacity: 0.7; }
.cat-dot { width: 16rpx; height: 64rpx; border-radius: 8rpx; margin-right: 24rpx; flex-shrink: 0; }
.cat-acid { background: #1E6A4F; } .cat-nutri { background: #2B5C86; } .cat-plant { background: #667A2B; }
.cat-bio { background: #74507A; } .cat-detox { background: #8A6436; }
.cat-main { flex: 1; min-width: 0; }
.cat-name { font-size: 29rpx; font-weight: 600; }
.cat-count { font-size: 20rpx; color: #B8915A; margin-left: 12rpx; font-weight: 500; }
.cat-names { font-size: 22rpx; color: #66706B; margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.cert {
  width: 300rpx; margin-right: 20rpx; display: inline-flex; flex-direction: column; white-space: normal;
  background: #fff; border-radius: 24rpx; padding: 30rpx 26rpx; border: 1rpx solid #ECE6D8; min-height: 230rpx;
}
.cert-code { font-size: 34rpx; font-weight: 700; color: #B8915A; font-family: Georgia, serif; }
.cert-title { font-size: 26rpx; font-weight: 600; color: #17201C; margin-top: 12rpx; line-height: 1.4; }
.cert-desc { font-size: 21rpx; color: #66706B; margin-top: 8rpx; line-height: 1.5; }

.about {
  background: #fff; border-radius: 24rpx; padding: 44rpx 40rpx; position: relative; overflow: hidden;
  border-left: 8rpx solid #B8915A; box-shadow: 0 8rpx 32rpx rgba(13,59,46,0.06);
}
.about-slogan { font-size: 40rpx; font-weight: 700; color: #0D3B2E; margin-top: 12rpx; }
.about-text { font-size: 25rpx; color: #4B5550; line-height: 1.8; margin-top: 16rpx; }
.about-cta { font-size: 25rpx; color: #2C7A5B; font-weight: 600; margin-top: 24rpx; }

.contact-band {
  background: linear-gradient(140deg, #0D3B2E, #1B5E46); border-radius: 24rpx; padding: 44rpx 40rpx; color: #fff;
}
.cb-title { font-size: 36rpx; font-weight: 700; }
.cb-sub { font-size: 24rpx; opacity: 0.75; margin-top: 8rpx; }
.cb-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 32rpx; }
.cb-btn { background: #B8915A; height: 80rpx; font-size: 28rpx; letter-spacing: 1rpx; }
.cb-link { font-size: 25rpx; color: #E3C795; }
