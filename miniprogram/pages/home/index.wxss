page { background: #F6F5F1; }

/* 顶部 */
.top { background: #fff; padding-bottom: 20rpx; }
.nav { display: flex; align-items: center; padding: 0 32rpx; }
.nav-logo { width: 52rpx; height: 52rpx; }
.nav-wm { display: flex; flex-direction: column; margin-left: 16rpx; line-height: 1.1; }
.nav-cn { font-family: var(--serif); font-size: 32rpx; font-weight: 700; color: var(--c-red); letter-spacing: 6rpx; }
.nav-en { font-size: 15rpx; letter-spacing: 4rpx; color: var(--c-green); margin-top: 4rpx; }

.search {
  margin: 20rpx 32rpx 0; height: 76rpx; border: 1rpx solid var(--c-line); border-radius: 6rpx;
  display: flex; align-items: center; padding: 0 8rpx 0 24rpx; background: var(--c-paper);
}
.search-icon { width: 24rpx; height: 24rpx; border: 2rpx solid var(--c-muted); border-radius: 50%; position: relative; flex-shrink: 0; }
.search-icon::after { content: ''; position: absolute; width: 9rpx; height: 2rpx; background: var(--c-muted); right: -8rpx; bottom: -3rpx; transform: rotate(45deg); }
.search-text { flex: 1; margin-left: 18rpx; font-size: 25rpx; color: var(--c-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.search-go {
  height: 58rpx; line-height: 58rpx; padding: 0 22rpx; border-radius: 4rpx; background: var(--c-green); color: #fff;
  font-size: 23rpx; letter-spacing: 1rpx; white-space: nowrap; flex-shrink: 0;
}

/* 主视觉 */
.hero { position: relative; background: #fff; border-top: 1rpx solid var(--c-line-2); overflow: hidden; }
.hero-mol {
  position: absolute; right: -150rpx; top: 96rpx; width: 440rpx; height: 310rpx; opacity: 0.5;
  background: url("data:image/svg+xml;base64,") no-repeat center / contain;
}
.hero-body { position: relative; padding: 44rpx 32rpx 48rpx; }
.lang { display: flex; align-items: center; font-size: 22rpx; color: var(--c-muted); border: 1rpx solid var(--c-line); border-radius: 4rpx; padding: 6rpx 16rpx; background: #fff; }
.lang .on { color: var(--c-green); font-weight: 600; }
.lang-sep { width: 1rpx; height: 20rpx; background: var(--c-line); margin: 0 14rpx; }
.hero-title { font-family: var(--brush); font-weight: normal; font-size: 60rpx; line-height: 1.35; margin-top: 36rpx; letter-spacing: 4rpx; color: var(--c-ink); }
.hero-title view:first-child { color: var(--c-green); }
.hero-sub { font-size: 25rpx; color: var(--c-sub); margin-top: 20rpx; line-height: 1.7; max-width: 520rpx; }
.hero-actions { display: flex; margin-top: 40rpx; }
.hero-actions .btn { height: 80rpx; padding: 0 36rpx; font-size: 27rpx; margin-right: 20rpx; }

.hero-band { display: flex; background: var(--c-green); color: #fff; padding: 26rpx 12rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; padding: 0 6rpx; }
.stat + .stat::before { content: ''; position: absolute; left: 0; top: 10rpx; bottom: 10rpx; width: 1rpx; background: rgba(255,255,255,0.25); }
.stat-v { font-size: 34rpx; font-weight: 500; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; line-height: 1.3; }
.stat-l { font-size: 19rpx; opacity: 0.75; margin-top: 4rpx; line-height: 1.35; }

/* 养殖品种：细线分格 */
.sol-grid { display: flex; flex-wrap: wrap; margin: 0 32rpx; border-top: 1rpx solid var(--c-line); border-left: 1rpx solid var(--c-line); background: #fff; }
.sol { width: 50%; padding: 28rpx 26rpx 30rpx; border-right: 1rpx solid var(--c-line); border-bottom: 1rpx solid var(--c-line); }
.sol-top { display: flex; align-items: flex-start; justify-content: space-between; }
.sol-icon {
  width: 88rpx; height: 88rpx; border-radius: 50%; border: 1rpx solid var(--c-green);
  display: flex; align-items: center; justify-content: center;
}
.sol-icon image { width: 60rpx; height: 60rpx; }
.sol-en { font-size: 17rpx; letter-spacing: 3rpx; color: var(--c-muted); }
.sol-name { font-family: var(--brush); font-weight: normal; font-size: 36rpx; margin-top: 20rpx; letter-spacing: 2rpx; }
.sol-focus { font-size: 21rpx; color: var(--c-sub); margin-top: 6rpx; line-height: 1.5; }

.tree-cta { display: flex; align-items: center; justify-content: space-between; margin: 0 32rpx; padding: 26rpx 26rpx; background: #fff; border: 1rpx solid var(--c-line); border-top: none; }
.tree-cta-t { font-size: 26rpx; color: var(--c-green); letter-spacing: 1rpx; }

/* 商品流 */
.feed { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 0 32rpx; }
.feed-cell { width: calc(50% - 9rpx); margin-bottom: 18rpx; }

/* 目录 */
.toc { margin: 0 32rpx; background: #fff; border: 1rpx solid var(--c-line); border-radius: 8rpx; }
.toc-row { display: flex; align-items: center; padding: 28rpx 26rpx; border-bottom: 1rpx solid var(--c-line-2); }
.toc-row:last-child { border-bottom: none; }
.toc-no { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 22rpx; color: var(--c-red); width: 56rpx; flex-shrink: 0; letter-spacing: 1rpx; }
.toc-main { flex: 1; min-width: 0; }
.toc-name { font-family: var(--serif); font-size: 29rpx; font-weight: 700; letter-spacing: 2rpx; }
.toc-names { font-size: 21rpx; color: var(--c-muted); margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.toc-count { font-size: 24rpx; color: var(--c-sub); margin-left: 20rpx; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }

/* 资质 */
.hscroll { width: 100%; white-space: nowrap; }
.hscroll-inner { display: inline-flex; padding: 0 32rpx; }
.seal {
  width: 220rpx; height: 220rpx; border-radius: 50%; border: 1rpx solid var(--c-green); margin-right: 18rpx; flex-shrink: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fff; align-self: center;
  position: relative;
}
.seal::before { content: ''; position: absolute; left: 10rpx; top: 10rpx; right: 10rpx; bottom: 10rpx; border-radius: 50%; border: 1rpx solid #C6D6CC; }
.seal-logo { width: 48rpx; height: 48rpx; }
.seal-t { font-size: 20rpx; letter-spacing: 5rpx; color: var(--c-green); margin-top: 10rpx; font-weight: 600; }
.seal-s { font-size: 13rpx; letter-spacing: 2rpx; color: var(--c-sub); margin-top: 2rpx; }
.cert {
  width: 300rpx; white-space: normal; background: #fff; border: 1rpx solid var(--c-line); border-radius: 8rpx;
  padding: 28rpx; margin-right: 18rpx; display: flex; flex-direction: column; flex-shrink: 0;
}
.cert-code { font-size: 30rpx; font-weight: 600; color: var(--c-green); letter-spacing: 1rpx; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
.cert-title { font-size: 25rpx; font-weight: 600; margin-top: 12rpx; }
.cert-desc { font-size: 21rpx; color: var(--c-sub); margin-top: 6rpx; line-height: 1.55; }

/* 关于 */
.about { background: #fff; border: 1rpx solid var(--c-line); border-radius: 8rpx; padding: 40rpx 36rpx; }
.about-slogan { font-family: var(--brush); font-weight: normal; font-size: 44rpx; line-height: 1.45; margin-top: 24rpx; letter-spacing: 2rpx; }
.about-text { font-size: 25rpx; color: var(--c-sub); line-height: 1.85; margin-top: 22rpx; }
.about-cta { font-size: 24rpx; color: var(--c-green); margin-top: 24rpx; }

/* 页脚 */
.foot { margin-top: 72rpx; background: var(--c-green); color: #fff; padding: 52rpx 32rpx 40rpx; }
.foot .red-bar { border-left-color: #D2353D; }
.foot-name { font-size: 30rpx; letter-spacing: 6rpx; font-weight: 500; line-height: 1.5; }
.foot-sub { font-size: 22rpx; opacity: 0.75; margin-top: 16rpx; line-height: 1.7; padding-left: 28rpx; }
.foot-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 36rpx; padding-left: 28rpx; }
.foot-btn { height: 72rpx; line-height: 72rpx; padding: 0 32rpx; border: 1rpx solid rgba(255,255,255,0.6); border-radius: 4rpx; font-size: 28rpx; letter-spacing: 2rpx; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
.foot-link { font-size: 24rpx; opacity: 0.9; }
.chev-w { border-color: #fff; }
.foot-note { font-size: 19rpx; opacity: 0.5; margin-top: 44rpx; text-align: center; letter-spacing: 1rpx; }
