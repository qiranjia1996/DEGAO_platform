<!-- 顶部：Logo + 字标（右侧留给微信胶囊按钮） -->
<view class="top" style="padding-top: {{navTop}}px">
  <view class="nav" style="height: {{navHeight}}px">
    <image class="nav-logo" src="/images/brand/logo-mark.png" mode="aspectFit" />
    <view class="nav-wm">
      <text class="nav-cn">德高农牧</text>
      <text class="nav-en">DEGAO NONGMU</text>
    </view>
  </view>

  <view class="search" bindtap="goAdvisor" hover-class="btn-hover">
    <view class="search-icon"></view>
    <text class="search-text">{{t.home.searchHint}}</text>
    <text class="search-go">{{t.home.ctaAdvisor}}</text>
  </view>
</view>

<!-- 主视觉：白底 + 分子线稿 + 包装式绿色底带 -->
<view class="hero">
  <view class="hero-mol"></view>
  <view class="hero-body">
    <view class="row-between">
      <text class="eyebrow">{{t.home.heroKicker}}</text>
      <view class="lang" bindtap="toggleLang" hover-class="btn-hover">
        <text class="{{lang === 'zh' ? 'on' : ''}}">中</text>
        <text class="lang-sep"></text>
        <text class="{{lang === 'en' ? 'on' : ''}}">EN</text>
      </view>
    </view>
    <view class="hero-title">
      <view wx:for="{{heroTitle}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="hero-sub">{{t.home.heroSub}}</view>
    <view class="hero-actions">
      <view class="btn btn-primary" bindtap="goAdvisor" hover-class="btn-hover">{{t.home.ctaAdvisor}}</view>
      <view class="btn btn-ghost" bindtap="goProducts" hover-class="btn-hover">{{t.home.ctaProducts}}</view>
    </view>
  </view>
  <view class="hero-band">
    <view class="stat" wx:for="{{company.stats}}" wx:key="label">
      <text class="stat-v">{{item.value}}</text>
      <text class="stat-l">{{item.label}}</text>
    </view>
  </view>
</view>

<!-- 按养殖品种 -->
<view class="section">
  <view class="section-head">
    <view>
      <view class="section-title">{{t.home.solutions}}</view>
      <view class="section-sub">{{t.home.solutionsSub}}</view>
    </view>
  </view>
  <view class="sol-grid">
    <view class="sol" wx:for="{{solutions}}" wx:key="id" data-id="{{item.id}}" bindtap="goSpecies" hover-class="row-hover">
      <view class="sol-top">
        <view class="sol-icon"><image src="/images/species/{{item.id}}.png" mode="aspectFit" /></view>
        <text class="sol-en">{{item.en}}</text>
      </view>
      <view class="sol-name">{{item.name}}</view>
      <view class="sol-focus">{{item.focus}}</view>
    </view>
  </view>
  <view class="tree-cta" bindtap="goTree" hover-class="row-hover">
    <text class="tree-cta-t">{{t.home.treeCta}}</text>
    <view class="chev"></view>
  </view>
</view>

<!-- 主推产品 -->
<view class="section">
  <view class="section-head">
    <view>
      <view class="section-title">{{t.home.featured}}</view>
      <view class="section-sub">{{t.home.featuredSub}}</view>
    </view>
    <view class="section-link row" bindtap="goProducts">{{t.common.viewAll}}<view class="chev"></view></view>
  </view>
  <view class="feed">
    <view class="feed-cell" wx:for="{{featured}}" wx:key="id">
      <product-card product="{{item}}" />
    </view>
  </view>
</view>

<!-- 产品系列：目录式 -->
<view class="section">
  <view class="section-head">
    <view>
      <view class="section-title">{{t.home.categories}}</view>
      <view class="section-sub">{{t.home.categoriesSub}}</view>
    </view>
  </view>
  <view class="toc">
    <view class="toc-row" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="goCategory" hover-class="row-hover">
      <text class="toc-no">0{{index + 1}}</text>
      <view class="toc-main">
        <view class="toc-name">{{item.name}}</view>
        <view class="toc-desc">{{item.desc}}</view>
        <view class="toc-names">{{item.names}}</view>
      </view>
      <text class="toc-count">{{item.count}}</text>
      <view class="chev"></view>
    </view>
  </view>
</view>

<!-- 资质 -->
<view class="section">
  <view class="section-head">
    <view>
      <view class="section-title">{{t.home.trust}}</view>
      <view class="section-sub">{{t.home.trustSub}}</view>
    </view>
    <view class="section-link row" bindtap="goAbout">{{t.common.more}}<view class="chev"></view></view>
  </view>
  <scroll-view scroll-x class="hscroll" enhanced show-scrollbar="{{false}}">
    <view class="hscroll-inner">
      <view class="seal">
        <image class="seal-logo" src="/images/brand/logo-mark.png" mode="aspectFit" />
        <text class="seal-t">QUALITY</text>
        <text class="seal-s">YOU CAN TRUST</text>
      </view>
      <view class="cert" wx:for="{{company.certs}}" wx:key="code">
        <text class="cert-code">{{item.code}}</text>
        <text class="cert-title">{{item.title}}</text>
        <text class="cert-desc">{{item.desc}}</text>
      </view>
    </view>
  </scroll-view>
</view>

<!-- 关于 -->
<view class="section container">
  <view class="about" bindtap="goAbout" hover-class="row-hover">
    <text class="eyebrow">{{t.home.aboutTitle}}</text>
    <view class="about-slogan red-bar">{{company.slogan}}</view>
    <view class="about-text">{{company.about}}</view>
    <view class="about-cta row">{{t.home.aboutCta}}<view class="chev"></view></view>
  </view>
</view>

<!-- 页脚：包装底部的绿带 + 红色竖条 -->
<view class="foot">
  <view class="foot-name red-bar">{{company.name}}</view>
  <view class="foot-sub">{{t.home.contactTitle}} · {{t.home.contactSub}}</view>
  <view class="foot-actions">
    <view class="foot-btn" bindtap="call" hover-class="btn-hover">{{company.phone}}</view>
    <view class="foot-link row" bindtap="goContact">{{t.nav.contact}}<view class="chev chev-w"></view></view>
  </view>
  <view class="foot-note">{{t.common.demo}}</view>
</view>
