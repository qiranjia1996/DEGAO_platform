.profile { display: flex; align-items: center; padding: 56rpx 32rpx 48rpx; background: #fff; border-bottom: 1rpx solid var(--c-line); }
.avatar { width: 96rpx; height: 96rpx; flex-shrink: 0; padding: 16rpx; border: 1rpx solid var(--c-line); border-radius: 50%; }
.profile-main { margin-left: 28rpx; }
.hello { font-family: var(--brush); font-weight: normal; font-size: 42rpx; letter-spacing: 2rpx; }
.hello-sub { font-size: 24rpx; color: var(--c-sub); margin-top: 6rpx; }

.quick { display: flex; margin: 24rpx 32rpx 0; background: #fff; border: 1rpx solid var(--c-line); border-radius: 8rpx; }
.q { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 30rpx 0; }
.q + .q { border-left: 1rpx solid var(--c-line-2); }
.q-v { font-size: 44rpx; font-weight: 300; color: var(--c-green); font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
.q-l { font-size: 23rpx; color: var(--c-sub); }

.menu { margin: 24rpx 32rpx 0; padding: 4rpx 28rpx; }
.menu-row { display: flex; align-items: center; padding: 30rpx 0; border-bottom: 1rpx solid var(--c-line-2); }
.menu-row:last-child { border-bottom: none; }
.menu-ico { width: 48rpx; color: var(--c-green); font-size: 28rpx; }
.menu-t { flex: 1; font-size: 28rpx; }

.lang-title { font-size: 25rpx; color: var(--c-sub); padding: 24rpx 0 18rpx; }
.seg { display: flex; border: 1rpx solid var(--c-line); border-radius: 6rpx; margin-bottom: 24rpx; overflow: hidden; }
.seg-i { flex: 1; text-align: center; height: 72rpx; line-height: 72rpx; font-size: 26rpx; color: var(--c-sub); }
.seg-i + .seg-i { border-left: 1rpx solid var(--c-line); }
.seg-on { background: var(--c-green); color: #fff; }
