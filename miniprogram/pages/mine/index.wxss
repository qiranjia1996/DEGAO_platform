.profile { position: relative; overflow: hidden; display: flex; align-items: center; padding: 56rpx 40rpx 100rpx; background: linear-gradient(150deg, #0A2F24, #17533F); color: #fff; }
.profile-ring { position: absolute; width: 400rpx; height: 400rpx; border-radius: 50%; border: 2rpx solid rgba(212,177,122,0.3); right: -120rpx; top: -160rpx; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 30rpx; border: 3rpx solid #D4B17A; color: #D4B17A; display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 700; font-family: Georgia, serif; flex-shrink: 0; }
.profile-main { margin-left: 28rpx; }
.hello { font-size: 36rpx; font-weight: 700; }
.hello-sub { font-size: 24rpx; opacity: 0.72; margin-top: 6rpx; }

.quick { display: flex; margin: -60rpx 24rpx 0; position: relative; z-index: 2; background: #fff; border-radius: 24rpx; box-shadow: 0 12rpx 40rpx rgba(13,59,46,0.08); }
.q { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 32rpx 0; }
.q + .q { border-left: 1rpx solid #EFECE5; }
.q-v { font-size: 44rpx; font-weight: 700; color: #0D3B2E; font-family: Georgia, serif; }
.q-l { font-size: 23rpx; color: #66706B; }

.menu { margin: 24rpx 24rpx 0; padding: 8rpx 32rpx; }
.menu-row { display: flex; align-items: center; padding: 30rpx 0; border-bottom: 1rpx solid #EFECE5; }
.menu-row:last-child { border-bottom: none; }
.row-hover { opacity: 0.7; }
.menu-ico { width: 48rpx; color: #B8915A; font-size: 30rpx; }
.menu-t { flex: 1; font-size: 28rpx; }

.lang-title { font-size: 26rpx; color: #66706B; padding: 24rpx 0 18rpx; }
.seg { display: flex; background: #F2F0EA; border-radius: 16rpx; padding: 6rpx; margin-bottom: 24rpx; }
.seg-i { flex: 1; text-align: center; height: 72rpx; line-height: 72rpx; border-radius: 12rpx; font-size: 26rpx; color: #66706B; }
.seg-on { background: #0D3B2E; color: #fff; font-weight: 600; }
