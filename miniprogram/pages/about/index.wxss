.banner { position: relative; overflow: hidden; background: #fff; padding: 56rpx 32rpx 56rpx; border-bottom: 1rpx solid var(--c-line); }
.b-mol { position: absolute; right: -150rpx; top: 30rpx; width: 440rpx; height: 310rpx; opacity: 0.45;
  background: url("data:image/svg+xml;base64,") no-repeat center / contain; }
.b-name { font-size: 26rpx; color: var(--c-sub); margin-top: 18rpx; position: relative; letter-spacing: 2rpx; }
.b-slogan { font-family: var(--brush); font-weight: normal; font-size: 58rpx; margin-top: 18rpx; position: relative; letter-spacing: 4rpx; line-height: 1.35; }
.b-tag { font-size: 25rpx; color: var(--c-sub); margin-top: 14rpx; position: relative; }

.stats { display: flex; background: var(--c-green); color: #fff; padding: 28rpx 12rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; }
.stat + .stat::before { content: ''; position: absolute; left: 0; top: 8rpx; bottom: 8rpx; width: 1rpx; background: rgba(255,255,255,0.25); }
.stat-v { font-size: 34rpx; font-weight: 500; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
.stat-l { font-size: 19rpx; opacity: 0.75; text-align: center; padding: 0 6rpx; line-height: 1.35; }

.block { background: #fff; margin-top: 20rpx; padding: 40rpx 32rpx; border-top: 1rpx solid var(--c-line); border-bottom: 1rpx solid var(--c-line); }
.block-title { font-family: var(--brush); font-weight: normal; font-size: 38rpx; margin-bottom: 26rpx; letter-spacing: 2rpx; border-left: 6rpx solid var(--c-red); padding-left: 18rpx; line-height: 1.2; }
.para { font-size: 27rpx; color: #3A403C; line-height: 1.95; margin-bottom: 18rpx; text-align: justify; }

.timeline { position: relative; padding-left: 36rpx; }
.timeline::before { content: ''; position: absolute; left: 7rpx; top: 22rpx; bottom: 22rpx; width: 1rpx; background: var(--c-line); }
.tl { position: relative; display: flex; align-items: baseline; padding: 16rpx 0; }
.tl-dot { position: absolute; left: -36rpx; top: 28rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #fff; border: 2rpx solid var(--c-green); box-sizing: border-box; }
.tl-year { font-size: 28rpx; color: var(--c-green); font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; width: 100rpx; flex-shrink: 0; }
.tl-text { font-size: 26rpx; color: #3A403C; }

.certs { display: flex; flex-wrap: wrap; border-top: 1rpx solid var(--c-line); border-left: 1rpx solid var(--c-line); }
.cert { width: 50%; border-right: 1rpx solid var(--c-line); border-bottom: 1rpx solid var(--c-line); padding: 26rpx 22rpx; display: flex; flex-direction: column; }
.cert-code { font-size: 28rpx; font-weight: 600; color: var(--c-green); font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
.cert-title { font-size: 25rpx; font-weight: 500; margin-top: 8rpx; line-height: 1.4; }
.cert-desc { font-size: 21rpx; color: var(--c-sub); margin-top: 6rpx; line-height: 1.5; }

.pf { display: flex; padding: 24rpx 0; border-bottom: 1rpx solid var(--c-line-2); }
.pf:last-child { border-bottom: none; }
.pf-no { font-size: 22rpx; color: var(--c-red); width: 60rpx; flex-shrink: 0; padding-top: 6rpx; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
.pf-main { flex: 1; }
.pf-name { font-family: var(--serif); font-size: 29rpx; font-weight: 700; margin-bottom: 14rpx; letter-spacing: 2rpx; }
