.hotline { position: relative; overflow: hidden; margin: 24rpx; border-radius: 28rpx; padding: 48rpx 40rpx; color: #fff; background: linear-gradient(150deg, #0A2F24, #17533F); }
.hl-ring { position: absolute; width: 380rpx; height: 380rpx; border-radius: 50%; border: 2rpx solid rgba(212,177,122,0.3); right: -120rpx; top: -140rpx; }
.hl-num { font-size: 60rpx; font-weight: 700; letter-spacing: 2rpx; font-family: Georgia, serif; margin-top: 12rpx; }
.hl-name { font-size: 23rpx; opacity: 0.7; margin-top: 6rpx; }
.hl-btn { width: 220rpx; height: 72rpx; margin-top: 32rpx; font-size: 26rpx; }

.info { margin: 0 24rpx; padding: 8rpx 32rpx; }
.info-row { display: flex; align-items: flex-start; padding: 26rpx 0; border-bottom: 1rpx solid #EFECE5; }
.info-row:last-child { border-bottom: none; }
.info-k { width: 110rpx; font-size: 24rpx; color: #9AA19D; flex-shrink: 0; padding-top: 2rpx; }
.info-v { flex: 1; font-size: 27rpx; line-height: 1.5; word-break: break-all; }
.info-copy { font-size: 23rpx; color: #2C7A5B; margin-left: 16rpx; padding-top: 2rpx; }

.form { margin: 24rpx 24rpx 0; }
.form-title { font-size: 30rpx; font-weight: 700; margin-bottom: 4rpx; }
.form-btn { margin-top: 28rpx; }
