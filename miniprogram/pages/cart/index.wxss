.empty { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.empty-mark { width: 96rpx; height: 96rpx; opacity: 0.9; }
.empty-t { font-family: var(--brush); font-weight: normal; font-size: 40rpx; margin-top: 40rpx; letter-spacing: 2rpx; }
.empty-s { font-size: 25rpx; color: var(--c-muted); margin-top: 12rpx; }
.empty-btn { margin-top: 52rpx; width: 360rpx; }

.head { font-size: 22rpx; color: var(--c-muted); padding: 28rpx 32rpx 4rpx; letter-spacing: 1rpx; }
.line { display: flex; background: #fff; margin: 16rpx 32rpx 0; border: 1rpx solid var(--c-line); border-radius: 8rpx; overflow: hidden; position: relative; }
.line-visual { width: 190rpx; flex-shrink: 0; border-right: 1rpx solid var(--c-line-2); }
.line-main { flex: 1; padding: 20rpx 22rpx; display: flex; flex-direction: column; min-width: 0; }
.line-title { font-size: 28rpx; font-weight: 500; line-height: 1.4; padding-right: 60rpx; }
.line-sub { font-size: 22rpx; color: var(--c-muted); margin-top: 6rpx; }
.line-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 16rpx; }
.line-remove { position: absolute; right: 22rpx; top: 20rpx; font-size: 22rpx; color: var(--c-muted); }
.st-btn { width: 56rpx; height: 56rpx; }
.stepper { height: 56rpx; }
.st-n { line-height: 56rpx; min-width: 56rpx; }

.total { flex: 1; display: flex; align-items: baseline; }
.total-l { font-size: 25rpx; color: var(--c-sub); }
.total-v { font-size: 40rpx; margin-left: 10rpx; font-weight: 500; }
.total-n { font-size: 22rpx; color: var(--c-muted); margin-left: 12rpx; }
