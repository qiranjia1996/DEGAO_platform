.empty { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.empty-mark { width: 120rpx; height: 120rpx; border-radius: 30rpx; border: 3rpx solid #D4B17A; color: #B8915A; display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 700; font-family: Georgia, serif; }
.empty-t { font-size: 32rpx; font-weight: 600; margin-top: 36rpx; }
.empty-s { font-size: 25rpx; color: #9AA19D; margin-top: 10rpx; }
.empty-btn { margin-top: 48rpx; width: 360rpx; }

.head { font-size: 24rpx; color: #9AA19D; padding: 28rpx 32rpx 8rpx; }
.line { display: flex; background: #fff; margin: 16rpx 24rpx 0; border-radius: 24rpx; overflow: hidden; box-shadow: 0 6rpx 24rpx rgba(13,59,46,0.05); position: relative; }
.line-visual { width: 200rpx; flex-shrink: 0; }
.line-main { flex: 1; padding: 22rpx 24rpx; display: flex; flex-direction: column; min-width: 0; }
.line-title { font-size: 28rpx; font-weight: 600; line-height: 1.4; padding-right: 60rpx; }
.line-sub { font-size: 22rpx; color: #9AA19D; margin-top: 6rpx; }
.line-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 16rpx; }
.line-remove { position: absolute; right: 24rpx; top: 22rpx; font-size: 22rpx; color: #B4BAB6; }
.stepper { display: flex; align-items: center; }
.st-btn { width: 52rpx; height: 52rpx; border-radius: 26rpx; background: #F2F0EA; display: flex; align-items: center; justify-content: center; font-size: 30rpx; color: #0D3B2E; }
.st-n { min-width: 56rpx; text-align: center; font-size: 28rpx; font-weight: 600; }

.total { flex: 1; display: flex; align-items: baseline; }
.total-l { font-size: 25rpx; color: #66706B; }
.total-v { font-size: 40rpx; margin-left: 10rpx; }
.total-n { font-size: 22rpx; color: #9AA19D; margin-left: 12rpx; }
